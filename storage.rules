rules_version = '2';

// Backups are encrypted before upload, but encryption is not access control:
// these rules are what stop one account reading, replacing or destroying
// another's. Deny by default.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A strict filename pattern is what prevents a caller-supplied backup id
    // containing path segments from resolving outside the owner's prefix.
    function isBackupFile(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{1,64}[.]json$');
    }

    match /users/{uid}/backups/{fileName} {
      allow read: if isOwner(uid) && isBackupFile(fileName);
      // `resource == null` is the load-bearing clause: a replace must not be
      // able to reach this rule by being classified as a create. A new backup
      // gets a new name, so an existing one can never be silently overwritten.
      allow create: if isOwner(uid)
                    && isBackupFile(fileName)
                    && resource == null
                    && request.resource.size < 25 * 1024 * 1024
                    && request.resource.contentType == 'application/json';
      allow update: if false;
      allow delete: if isOwner(uid) && isBackupFile(fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
