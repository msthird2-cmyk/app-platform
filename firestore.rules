rules_version = '2';

// Deny by default. Nothing is readable or writable unless a rule below grants
// it, and every grant is anchored to request.auth.uid — never to a value the
// client supplies. See docs/ARCHITECTURE.md, "The Firebase boundary".
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- identity -------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Ownership always comes from the token, never from the document or path
    // segment the caller chose.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Financial writes additionally require a verified address, so an account
    // registered against someone else's email cannot record data.
    function isVerified() {
      // `.get` with a default: a token that omits the claim entirely — a custom
      // token, or some provider flows — must produce a denial decision rather
      // than an evaluation error. Same outcome, deterministic instead of
      // exceptional, and it cannot turn into a surprise inside a larger
      // boolean expression later.
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    // ---- reserved fields -------------------------------------------------

    // Ownership, role and entitlement state is decided by the token and by a
    // trusted server. A client that can write these names into its own
    // document can later be mistaken for privileged by any code — client,
    // rule, or future backend — that reads them back, and `resource.data.role`
    // reads exactly like a claim at the point of use.
    //
    // A domain record is deliberately open-ended, so this is a denylist rather
    // than an allowlist: an application may add any field it likes except one
    // that could be confused for authorization state. The stronger allowlist
    // form is already used where the shape is known (`isProfileShape`,
    // `isRecoveryEscrow`); extending it to records is a schema change, not a
    // rules change, and waits for the encrypted record envelope.
    //
    // `hasAny` matches whole keys, so a legitimate `planName` or
    // `userIdentifier` is unaffected.
    function hasNoReservedFields() {
      return !request.resource.data.keys().hasAny([
        'ownerId', 'userId', 'uid',
        'isAdmin', 'admin', 'role', 'roles',
        'permissions', 'entitlements', 'plan', 'claims',
        'isVerified', 'emailVerified', 'createdBy'
      ]);
    }

    // ---- record collections ---------------------------------------------

    // The collections applications are allowed to store records in. A restore
    // bundle naming anything else is refused here as well as in the client.
    function isRecordCollection(name) {
      return name in [
        'assets', 'liabilities', 'snapshots',
        'holdings', 'transactions', 'prices',
        'expenses', 'budgets', 'rules'
      ];
    }

    // updatedAt must be the server's clock, so a device with a skewed or
    // hostile clock cannot pin a record by claiming a future timestamp.
    function hasServerTimestamp() {
      return request.resource.data.updatedAt == request.time;
    }

    function hasValidIdentity(docId) {
      return request.resource.data.id is string
        && request.resource.data.id == docId
        && request.resource.data.revision is int
        && request.resource.data.revision > 0;
    }

    // X-2: a record's domain fields are sealed before they reach here, so the
    // document carries an envelope and nothing else of substance. Requiring it
    // is what stops a client — or a future bug above this layer — from writing
    // a plaintext record that the rules would otherwise happily accept.
    //
    // The shape is checked, not just the presence: `ct` and `iv` are the
    // ciphertext and nonce, `v` and `alg` are covered by the authentication tag
    // and so cannot be edited to change how the payload is read. There is
    // deliberately no digest or checksum field, here or in the writer.
    function hasRecordEnvelope() {
      return 'enc' in request.resource.data
        && request.resource.data.enc.keys().hasOnly(['v', 'alg', 'iv', 'ct'])
        && request.resource.data.enc.v == 1
        && request.resource.data.enc.alg == 'AES-GCM'
        && request.resource.data.enc.iv is string
        && request.resource.data.enc.ct is string;
    }

    // The only fields a record document may carry: the sync metadata the rules
    // and queries read, plus the sealed payload. An allowlist rather than a
    // denylist, which is the tightening `hasNoReservedFields` deferred until
    // the encrypted envelope existed — a plaintext domain field is now not a
    // reserved name to be listed, it is simply not permitted.
    function hasOnlyRecordFields() {
      return request.resource.data.keys()
        .hasOnly(['id', 'revision', 'updatedAt', 'deletedAt', 'enc']);
    }

    function isCreatingRecord(docId) {
      return hasValidIdentity(docId)
        && hasServerTimestamp()
        && (request.resource.data.deletedAt == null
            || request.resource.data.deletedAt == request.time);
    }

    function isUpdatingRecord(docId) {
      return hasValidIdentity(docId)
        && hasServerTimestamp()
        // Revision never moves backwards.
        && request.resource.data.revision >= resource.data.revision
        // A tombstone is terminal: it can be hard-deleted but never edited,
        // so a slower device's stale write cannot resurrect it.
        && resource.data.deletedAt == null
        && (request.resource.data.deletedAt == null
            || request.resource.data.deletedAt == request.time);
    }

    match /users/{uid}/{collection}/{docId} {
      allow get, list: if isOwner(uid) && isRecordCollection(collection);
      allow create: if isOwner(uid) && isVerified()
                    && isRecordCollection(collection) && isCreatingRecord(docId)
                    && hasNoReservedFields()
                    && hasRecordEnvelope() && hasOnlyRecordFields();
      allow update: if isOwner(uid) && isVerified()
                    && isRecordCollection(collection) && isUpdatingRecord(docId)
                    && hasNoReservedFields()
                    && hasRecordEnvelope() && hasOnlyRecordFields();
      // Hard delete is permitted only so account deletion can remove the
      // subtree; ordinary removal goes through the tombstone above.
      allow delete: if isOwner(uid) && isRecordCollection(collection);
    }

    // ---- profile ---------------------------------------------------------

    // The client may write exactly one field. Any future server-controlled
    // field (plan, role, entitlements) is therefore unwritable by default
    // rather than needing to be remembered and denied later.
    function isProfileShape() {
      return request.resource.data.keys().hasOnly(['displayName'])
        && (!('displayName' in request.resource.data)
            || request.resource.data.displayName is string);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && isProfileShape();
      allow delete: if isOwner(uid);
    }

    // ---- backups ---------------------------------------------------------

    // There is no backup path, and that is the design rather than an omission.
    // A backup is an encrypted file the person exported and keeps themselves:
    // the server never receives one, so there is nothing here to authorise and
    // no metadata — size, record count, cadence — for an operator to read.
    // `users/{uid}/backups` therefore falls to the record rule above, which
    // refuses it because `backups` is not a record collection, and then to the
    // default deny at the bottom.

    // ---- deletion journal ------------------------------------------------

    // Lets an interrupted account deletion be detected and resumed.
    match /users/{uid}/deletion/{docId} {
      allow read, write: if isOwner(uid);
    }

    // ---- secondary records -----------------------------------------------

    // `write` is split into create/update/delete deliberately: on a delete
    // `request.resource` is null, so a field check written against a combined
    // `write` grant would fail to evaluate rather than pass.
    match /users/{uid}/devices/{deviceId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasNoReservedFields();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/settings/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasNoReservedFields();
      allow delete: if isOwner(uid);
    }

    // ---- recovery escrow -------------------------------------------------

    // The wrapped data encryption key for zero-trusted-device recovery.
    //
    // This is deliberately NOT the `recoveryCodes` path below, and the two are
    // not alternatives. That path holds recovery-code *hashes*, which are an
    // authentication credential: verifying one means comparing against a stored
    // value, and a client that can read the expected value can fake the answer,
    // so it stays closed until a trusted server can own the comparison. This
    // path holds no hash and no credential. It holds ciphertext.
    //
    // Nothing here is compared, by the client or by anyone else. A recovery code
    // derives a wrapping key, the wrapping key either opens the AEAD envelope or
    // does not, and a wrong code produces an authentication-tag failure rather
    // than an authorization decision. So the owner reading their own escrow
    // learns nothing they could not already compute, and the rule can be an
    // ordinary ownership check. See docs/ARCHITECTURE.md, "Why the recovery code
    // is escrow rather than a factor" — which also records that the
    // authentication form may be added alongside this one later.
    //
    // The shape is an allowlist rather than a denylist, like `isProfileShape`:
    // the fields are fully known, so anything else is a mistake. In particular
    // there is no room for a digest, checksum or verifier of the key or the
    // code. Such a field would let anyone holding this document test candidate
    // codes without paying for a key derivation, which is the only thing making
    // a 60-bit secret expensive to attack offline.
    function isRecoveryEscrow(escrowId) {
      return escrowId.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.keys().hasOnly([
             'id', 'version', 'algorithm', 'kdf', 'iterations',
             'salt', 'iv', 'wrappedKey', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.keys().hasAll([
             'id', 'version', 'algorithm', 'kdf', 'iterations',
             'salt', 'iv', 'wrappedKey', 'updatedAt'
           ])
        && request.resource.data.id == escrowId
        && request.resource.data.version == 1
        && request.resource.data.algorithm == 'AES-GCM'
        && request.resource.data.kdf == 'PBKDF2-SHA256'
        // The same bounds packages/security/src/kdfPolicy.ts enforces. Repeated
        // here because a rule cannot import one, and a document written with a
        // cost the client would later refuse to read is a key lost silently.
        && request.resource.data.iterations is int
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 1000000
        && request.resource.data.salt is string
        && request.resource.data.iv is string
        && request.resource.data.wrappedKey is string
        && request.resource.data.wrappedKey.size() <= 4096
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid}/recoveryEscrow/{escrowId} {
      allow get: if isOwner(uid);
      // Enumerating an escrow set says how many recovery paths exist. The owner
      // knows; nobody else needs a listing, and a fixed document id is enough.
      allow list: if false;
      allow create: if isOwner(uid)
        && isRecoveryEscrow(escrowId)
        && hasNoReservedFields()
        && request.resource.data.createdAt == request.time;
      // Re-escrowing under a new code replaces the wrapped copy. createdAt is
      // pinned to what was already stored so an update cannot rewrite history.
      allow update: if isOwner(uid)
        && isRecoveryEscrow(escrowId)
        && hasNoReservedFields()
        && request.resource.data.createdAt == resource.data.createdAt;
      // Deleting is the user's own decision to give up this recovery path.
      allow delete: if isOwner(uid);
    }

    // ---- trusted-device pairing -----------------------------------------

    // A relay, and only a relay. It carries two ephemeral public keys, a
    // commitment to the first of them, one ciphertext and some timestamps. It
    // holds no secret either device could not compute for itself.
    //
    // Note what is absent: there is no `verified`, no `status`, no verdict of
    // any kind. That is the point. On Spark there is no trusted server to
    // adjudicate a pairing, and a verdict a client can write is a verdict an
    // attacker can write — which is exactly the banned pattern in CLAUDE.md.
    // What authorises the transfer instead is that the wrapped key opens only
    // under a transport secret derived from both ephemeral keys, and the
    // trusted device publishes it only after a person has compared a six-digit
    // code on two screens. See packages/security/src/pairing.ts.
    //
    // The state machine is expressed as append-only fields rather than a status
    // string, so these rules can enforce it: each step may add its own field
    // once and may never change one already written, which makes replay and
    // rewrite impossible rather than merely discouraged.

    // The longest a session may claim to live. A client sets its own expiry, so
    // it is bounded here — otherwise a session could be minted that never ages
    // out, and an abandoned offer would stay openable indefinitely.
    function hasSaneExpiry() {
      return request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 900000;
    }

    function isPairingOffer(sessionId) {
      return sessionId.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.keys().hasOnly([
             'id', 'version', 'appName', 'commitment',
             'createdAt', 'updatedAt', 'expiresAt'
           ])
        && request.resource.data.keys().hasAll([
             'id', 'version', 'appName', 'commitment',
             'createdAt', 'updatedAt', 'expiresAt'
           ])
        && request.resource.data.id == sessionId
        && request.resource.data.version == 1
        && request.resource.data.appName is string
        && request.resource.data.commitment is string
        && request.resource.data.commitment.size() <= 128
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasSaneExpiry();
    }

    // Everything a session is identified by. None of it may ever change: a
    // rewritten commitment is the man-in-the-middle this design detects, and a
    // rewritten expiry is a session that never closes.
    function pairingCoreUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.version == resource.data.version
        && request.resource.data.appName == resource.data.appName
        && request.resource.data.commitment == resource.data.commitment
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt;
    }

    // Each progressive field may be written once. Absent stays absent or
    // becomes present; present never changes. Written out per field rather than
    // generically so that an auditor can read what is enforced.
    function initiatorKeyAppendOnly() {
      return !('initiatorPublicKey' in resource.data)
        || (('initiatorPublicKey' in request.resource.data)
            && request.resource.data.initiatorPublicKey == resource.data.initiatorPublicKey);
    }

    function responderKeyAppendOnly() {
      return !('responderPublicKey' in resource.data)
        || (('responderPublicKey' in request.resource.data)
            && request.resource.data.responderPublicKey == resource.data.responderPublicKey);
    }

    function wrappedAppendOnly() {
      return !('wrapped' in resource.data)
        || (('wrapped' in request.resource.data)
            && request.resource.data.wrapped == resource.data.wrapped);
    }

    function pairingKeyShape() {
      return (!('initiatorPublicKey' in request.resource.data)
              || (request.resource.data.initiatorPublicKey is string
                  && request.resource.data.initiatorPublicKey.size() <= 128))
        && (!('responderPublicKey' in request.resource.data)
            || (request.resource.data.responderPublicKey is string
                && request.resource.data.responderPublicKey.size() <= 128));
    }

    // The wrapped DEK, shaped. No digest, no hint, nothing that could verify a
    // guess offline — the same allowlist discipline as the recovery escrow.
    function wrappedShape() {
      return !('wrapped' in request.resource.data)
        || (request.resource.data.wrapped.keys().hasOnly(['v', 'alg', 'iv', 'ct'])
            && request.resource.data.wrapped.v == 1
            && request.resource.data.wrapped.alg == 'AES-GCM'
            && request.resource.data.wrapped.iv is string
            && request.resource.data.wrapped.ct is string
            && request.resource.data.wrapped.ct.size() <= 4096);
    }

    function isAdvancingPairing() {
      return request.resource.data.keys().hasOnly([
               'id', 'version', 'appName', 'commitment',
               'createdAt', 'updatedAt', 'expiresAt',
               'initiatorPublicKey', 'responderPublicKey', 'wrapped', 'consumedAt'
             ])
        && pairingCoreUnchanged()
        && request.resource.data.updatedAt == request.time
        // Expired sessions are dead. Nothing advances them, whatever state they
        // reached, and nothing extends them.
        && resource.data.expiresAt > request.time.toMillis()
        // Single use: once spent, the document is immutable.
        && !('consumedAt' in resource.data)
        && (!('consumedAt' in request.resource.data)
            || request.resource.data.consumedAt == request.time)
        && initiatorKeyAppendOnly()
        && responderKeyAppendOnly()
        && wrappedAppendOnly()
        && pairingKeyShape()
        && wrappedShape();
    }

    match /users/{uid}/pairing/{sessionId} {
      allow get: if isOwner(uid);
      // Both devices know the session id — it travels out of band, in the QR
      // code or link that starts the pairing. Nothing needs to enumerate them.
      allow list: if false;
      allow create: if isOwner(uid) && isPairingOffer(sessionId) && hasNoReservedFields();
      allow update: if isOwner(uid) && isAdvancingPairing() && hasNoReservedFields();
      // A user may abandon a pairing. Deleting destroys no key: the DEK is not
      // here, only a copy wrapped for one ephemeral transport key.
      allow delete: if isOwner(uid);
    }

    // ---- client-inaccessible -------------------------------------------

    // A verification code is a secret the client must not be able to read, and
    // a verification verdict is a decision the client must not be able to
    // make. Neither is possible without a trusted server, so the path is
    // closed to clients entirely.
    match /users/{uid}/deviceVerifications/{docId} {
      allow read, write: if false;
    }

    // Recovery-code hashes are an account-takeover credential. Client-side
    // comparison would mean handing the client the list to compare against,
    // so this path is closed until a trusted server can own the check.
    match /users/{uid}/recoveryCodes/{docId} {
      allow read, write: if false;
    }

    // ---- default deny ----------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
